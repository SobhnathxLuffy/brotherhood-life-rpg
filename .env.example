# Brotherhood Life RPG — environment template
# Copy to `.env` (local dev) or paste these into Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env — credentials stay out of git and out of code.

# ── Local sandbox dev (SQLite, zero setup) ──────────────────────────────
DATABASE_URL="file:../db/custom.db"

# ── Production (Vercel + Supabase Postgres) — set ALL of these in Vercel ─
# Supabase Dashboard → Connect → copy the two pooler URIs:
#   DATABASE_URL = Transaction pooler (port 6543) + pooler params — used by the app at runtime
#   DIRECT_URL   = Session pooler (port 5432) — used by `prisma db push`
#
# DATABASE_URL="postgresql://postgres.<proj-ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<proj-ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
#
# AUTH_SECRET: any long random string — signs session cookies/tokens (`openssl rand -hex 32`)
# CRON_SECRET: any long random string — /api/cron rejects callers without it (production only)
#
# AUTH_SECRET="paste-64-hex-chars-here"
# CRON_SECRET="paste-64-hex-chars-here"
